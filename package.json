{
  "name": "yt-rest-api",
  "version": "1.0.0",
  "description": "Enterprise-grade YouTube Clone REST API with ElysiaJS, Prisma, PostgreSQL, Redis, MinIO, and Docker",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch src/index.ts",
    "build": "bun build src/index.ts --outdir ./dist --target bun",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "prisma:seed": "bun run prisma/seed.ts",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/bun": "latest",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.0.0",
    "prisma": "6.4.1"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1150.0",
    "@aws-sdk/s3-request-presigner": "^3.1150.0",
    "@elysiajs/bearer": "^1.4.4",
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/jwt": "^1.4.2",
    "@elysiajs/swagger": "^1.3.1",
    "@prisma/client": "6.4.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.7",
    "elysia": "^1.4.30",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3"
  }
}

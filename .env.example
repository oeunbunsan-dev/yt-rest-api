# Server Environment
NODE_ENV=production
PORT=3000
API_PORT=3001
HOST=0.0.0.0
APP_URL=http://localhost:3001

# PostgreSQL Database
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/youtube_clone?schema=public
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=youtube_clone
DB_PORT=5433

# Redis Cache
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT Secrets
JWT_SECRET=replace_with_production_jwt_access_secret_key
JWT_REFRESH_SECRET=replace_with_production_jwt_refresh_secret_key
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# MinIO S3 Object Storage
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=youtube-clone-assets
MINIO_PUBLIC_URL=http://localhost:9000/youtube-clone-assets

# pgAdmin
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@youtubeclone.dev
PGADMIN_DEFAULT_PASSWORD=adminpassword

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_SEC=60
